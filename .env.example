# App Configuration
NEXT_PUBLIC_APP_NAME="Smart Finance Tracker"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration
DATABASE_URL="mysql://root:password@127.0.0.1:3306/smart_finance_tracker"

# Authentication Secrets & Expiries
AUTH_SECRET="your-auth-secret-key-here"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"

# Brevo Transactional Email Gateway API
BREVO_API_KEY="your-brevo-api-key-here"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Smart Finance Tracker"

# Gemini AI API Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_FALLBACK_API_KEY="your-gemini-fallback-api-key-here"
GEMINI_MODEL="gemini-2.5-flash-lite"
